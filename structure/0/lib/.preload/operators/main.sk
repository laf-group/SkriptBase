
# Skript Reflect
# Custom operator for easier variable assignment

# Everything in here is 'unsafe'
# Not to be used by anyone

import:
    ch.njol.skript.lang.Variable


effect %objects%[ ](=|->|=>|==)[ ]%objects%:
    trigger:
        set (raw expression of expr-1) to expr-2


effect %objects%[ ]+=[ ]%objects%:
    trigger:
        add expr-2 to (raw expression of expr-1)


effect %objects%[ ]-=[ ]%objects%:
    trigger:
        remove expr-2 from (raw expression of expr-1)


effect %object%++:
    trigger:
        add 1 to (raw expression of expr-1)


effect %object%--:
    trigger:
        remove 1 from (raw expression of expr-1)


expression:
    patterns: 
        %object% . %object%
        %objects% . %object%
        %object% . %objects%
        %objects% . %objects%
    get:
        add expr-1 to {_a::*}
        add expr-2 to {_b::*}
        return "%{_a::*}%%{_b::*}%"