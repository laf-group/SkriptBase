
# Skript Reflect, Luckperms
# Basic luckperms operations

# TODO
# Add temporary-perms syntax
# Add skript-reflect custom expression syntax

import:
    net.luckperms.api.LuckPermsProvider
    net.luckperms.api.model.user.User
    net.luckperms.api.node.Node
    net.luckperms.api.node.NodeType


on load:
    {$luckperms} = LuckPermsProvider.get()


function perms(player: offline player, action: string = "set", node: string, value: boolean = true) :: object:
    {_uuid} = {_player}'s uuid
    
    if {$luckperms}.getUserManager().isLoaded({_uuid}) is false:
        {$luckperms}.getUserManager().loadUser({_uuid})
    
    {_user} = {$luckperms}.getUserManager().getUser({_uuid})
    
    if {_user} is not set:
        throw runtime error "[LUCKPERMS] Could not load user data."
        
        return {_}
    
    switch {_action}:
        case "set" -> {_result} = {_user}.data().add(Node.builder("%{_node}%").value({_value}).build())
        case "remove" -> {_result} = {_user}.data().remove(Node.builder("%{_node}%").build())
        case "unset" -> {_result} = {_user}.data().remove(Node.builder("%{_node}%").build())
        
    {$luckperms}.getUserManager().saveUser({_user})

    return "Player: %{_player}%. Action: %{_action}% Node: %{_node}%. Result: %{_result}%"
            

function asyncperms(player: offline player, action: string = "set", node: string, value: boolean = true) :: object:
    async run 0 ticks later:
        perms({_player}, {_action}, {_node}, {_value})


function getprimarygroup(player: offline player) :: object:
    {_uuid} = {_player}'s uuid
    
    if {$luckperms}.getUserManager().isLoaded({_uuid}) is false:
        {$luckperms}.getUserManager().loadUser({_uuid})
    
    {_user} = {$luckperms}.getUserManager().getUser({_uuid})
    
    if {_user} is not set:
        throw runtime error "[LUCKPERMS] Could not load user data."
        return {_}
    
    {_primaryGroup} = {_user}.getPrimaryGroup()
    return {_primaryGroup}


expression:
    patterns:
        primary group of %offline player%
        %offline player%'[s] primary group
    
    get:
        {_player} = expr-1
        return getprimarygroup({_player})
