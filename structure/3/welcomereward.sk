
# Welcome Reward

# TODO
# Rewrite everyhing



# ================================================
#    Welcome Race System
# ================================================

# options:
#     Prefix: &6&lWELCOME &7| &r
#     RewardCmd: crate key give %player% 2_astral_lockpick 1
#     MaxWinners: 5

# variables:
#     {welcome.active} = false
#     {welcome.count} = 0


on load:
    set {%script%::prefix} to formatted "<gold><b>WELCOME <dark_gray>| <reset>"
    set {%script%::reward} to "crate key give {player} 2_astral_lockpick 1"
    set {%script%::maxwin} to 5
    set {%script%::active} to false


on first join:
    set {%script%::active} to true
    set {%script%::list::*} to {_}

    add formatted {%script%::prefix} . formatted "<yellow>%name of player% <gray>bergabung untuk pertama kalinya! Ketik <yellow>'welcome' <gray>untuk menyapa!" to {_t::*}
    add formatted "<gray>Welcome event dimulai." to {_t::*}
    send formatted (join {_t::*} with newline) to all players


    # Reset otomatis setelah 30 detik
    wait 30 seconds
    set {%script%::active} to false

    add formatted {%script%::prefix} . formatted "<gray>Welcome event berakhir." to {_t::*}
    send formatted (join {_t::*} with newline) to all players


on chat:
    {%script%::active} is true
    message contains "welcome"
    {%script%::list::*} doesn't contain player
    size of {%script%::list::*} < {%script%::maxwin}
    
    # add 1 to {%script%::maxwin}
    add player to {%script%::list::*}
    set {_r} to {%script%::reward}

    replace all "{player}" with (name of player) in {_r}
    execute console command {_r}

    add formatted {%script%::prefix} . formatted "<green>Kamu pemenang ke-" . size of {%script%::list::*} . formatted "! Hadiah diberikan.." to {_t::*}
    send formatted (join {_t::*} with newline) to player

    size of {%script%::list::*} >= 5

    add formatted {%script%::prefix} . formatted "<gray>Welcome event selesai." to {_t::*}
    send formatted (join {_t::*} with newline) to all players
    
    set {%script%::active} to false
    set {%script%::list::*} to {_}



