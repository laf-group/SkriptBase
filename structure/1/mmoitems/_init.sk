
import:
    net.Indyuce.mmoitems.api.event.MMOItemsReloadEvent


on MMOItemsReloadEvent:
    send info "%{-G:pass}%MMOItems reloaded, re-hooking MMOItems utilities"

    {_name} = script.name()
    {_path} = script.nameAndPath()
    {_path} = {_path}.substring(0, length of {_path} - length of {_name})
    reload script {_path}