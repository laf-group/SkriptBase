
# Skript Reflect
# FAWE's schematic helper

import:
    com.fastasyncworldedit.core.FaweAPI
    com.sk89q.worldedit.WorldEdit
    com.sk89q.worldedit.extent.clipboard.io.ClipboardFormats
    com.sk89q.worldedit.function.operation.Operations
    com.sk89q.worldedit.math.BlockVector3
    com.sk89q.worldedit.session.ClipboardHolder
    java.io.File
    java.io.FileInputStream

# TODO
# - Delete clipboard data after session finished

function pasteSchematicAsync(schematicName: text, loc: location):: object:
    {_file} = new File("plugins/FastAsyncWorldEdit/schematics/%{_schematicName}%.schem")
    {_world} = FaweAPI.getWorld({_loc}.getWorld().getName())  # get FAWE world

    async run 0 tick later:
        {_format} = ClipboardFormats.findByFile({_file})
        if {_format} is null:
            stop
        
        {_reader} = {_format}.getReader(new FileInputStream({_file}))
        {_clipboard} = {_reader}.read()
        {_reader}.close()

        {_editSession} = WorldEdit.getInstance().newEditSessionBuilder()
        {_editSession} = {_editSession}.world({_world})
        {_editSession} = {_editSession}.build()

        {_vec} = BlockVector3.at({_loc}.getBlockX(), {_loc}.getBlockY(), {_loc}.getBlockZ())

        {_holder} = new ClipboardHolder({_clipboard})

        {_operation} = {_holder}.createPaste({_editSession})
        {_operation} = {_operation}.to({_vec})
        {_operation} = {_operation}.ignoreAirBlocks(false)
        {_operation} = {_operation}.copyEntities(true)
        {_operation} = {_operation}.copyBiomes(true)
        {_operation} = {_operation}.build()
        
        Operations.complete({_operation})
        {_editSession}.close()

# command /pasteSchem <schem: text>:
#     permission: *
#     trigger:
#         pasteSchematicAsync({_schem}, player's location)