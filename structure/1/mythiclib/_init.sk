
on command "/ml", "/mythiclib", "/mythiclib:ml", "/mythiclib:mythiclib":
    wait 1 seconds
    send info "%{-G:pass}%MythicLib reloaded, re-hooking MythicLib utilities"

    {_name} = script.name()
    {_path} = script.nameAndPath()
    {_path} = {_path}.substring(0, length of {_path} - length of {_name})
    reload script {_path}