import:
    org.bukkit.event.inventory.InventoryClickEvent
    org.bukkit.event.inventory.ClickType
    org.bukkit.event.inventory.InventoryAction

on load:
    {-bugrock::actionField} = InventoryClickEvent.class.getDeclaredField("action")
    {-bugrock::actionField}.setAccessible(true)

    {-bugrock::clickField} = InventoryClickEvent.class.getDeclaredField("click")
    {-bugrock::clickField}.setAccessible(true)


on inventory click with priority lowest:
    raw unformatted name of player starts with "." # Bedrock player
    event-inventory action is instant move

    set {_type} to string tag "minecraft:custom_data;MMOITEMS_ITEM_TYPE" of nbt of event-item
    set {_id}   to string tag "minecraft:custom_data;MMOITEMS_ITEM_ID"   of nbt of event-item

    {_type} is set
    {_id} is set

    {-bugrock::actionField}.set(event, InventoryAction.PICKUP_HALF)
    {-bugrock::clickField}.set(event, ClickType.RIGHT)





